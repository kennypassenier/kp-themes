            "types": "./js/theme-picker.d.ts",
            "default": "./js/theme-picker.js"
        },
        "./js/registry": {
            "types": "./js/theme-registry.d.ts",
            "default": "./js/theme-registry.js"
        },
        "./js/no-flash": {
            "types": "./js/no-flash.d.ts",
            "default": "./js/no-flash.js"
        },
        "./js/components": {
            "types": "./js/components.d.ts",
            "default": "./js/components.js"
        },
        "./js/overlays": {
            "types": "./js/overlays.d.ts",
