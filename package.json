            "types": "./js/palette.d.ts",
            "default": "./js/palette.js"
        },
        "./js/datatable": {
            "types": "./js/datatable.d.ts",
            "default": "./js/datatable.js"
        },
        "./js/forms": {
            "types": "./js/forms.d.ts",
            "default": "./js/forms.js"
        },
        "./js/patterns": {
            "types": "./js/patterns.d.ts",
            "default": "./js/patterns.js"
        },
        "./js/structure": {
            "types": "./js/structure.d.ts",
            "default": "./js/structure.js"
        },
        "./js/sidenav": {
            "types": "./js/sidenav.d.ts",
            "default": "./js/sidenav.js"
        },
        "./js/datepicker": {
            "types": "./js/datepicker.d.ts",
            "default": "./js/datepicker.js"
        },
        "./js/upload": {
            "types": "./js/upload.d.ts",
            "default": "./js/upload.js"
        },
        "./js/wizard": {
            "types": "./js/wizard.d.ts",
            "default": "./js/wizard.js"
        },
        "./js/contrast": {
            "types": "./js/contrast.d.ts",
            "default": "./js/contrast.js"
        },
        "./js/colorpicker": {
            "types": "./js/colorpicker.d.ts",
            "default": "./js/colorpicker.js"
        },
        "./js/gridlayout": {
            "types": "./js/gridlayout.d.ts",
            "default": "./js/gridlayout.js"
        },
        "./js/tables": {
            "types": "./js/tables.d.ts",
            "default": "./js/tables.js"
        },
        "./js/strings": {
            "types": "./js/strings.d.ts",
            "default": "./js/strings.js"
        },
        "./js/diagnostics": {
            "types": "./js/diagnostics.d.ts",
            "default": "./js/diagnostics.js"
        },
        "./js/effects": {
            "types": "./js/effects.d.ts",
            "default": "./js/effects.js"
        },
        "./hooks/controllable": {
            "types": "./hooks/use-controllable.d.ts",
            "default": "./hooks/use-controllable.js"
        },
        "./css/retro-register": "./css/retro-register.css",
        "./css/retro-register/min": "./dist/css/retro-register.min.css",
        "./css/synthwave-register": "./css/synthwave-register.css",
        "./css/synthwave-register/min": "./dist/css/synthwave-register.min.css",
        "./css/phantom-register": "./css/phantom-register.css",
        "./css/phantom-register/min": "./dist/css/phantom-register.min.css",
        "./css/terminal-register": "./css/terminal-register.css",
        "./css/terminal-register/min": "./dist/css/terminal-register.min.css",
        "./css/brutalism-register": "./css/brutalism-register.css",
        "./css/titanium-register": "./css/titanium-register.css",
        "./css/brutalism-register/min": "./dist/css/brutalism-register.min.css",
        "./css/pastel-register": "./css/pastel-register.css",
        "./css/pastel-register/min": "./dist/css/pastel-register.min.css",
        "./css/shade-light-register": "./css/shade-light-register.css",
        "./css/shade-light-register/min": "./dist/css/shade-light-register.min.css",
        "./css/forest-register": "./css/forest-register.css",
        "./css/forest-register/min": "./dist/css/forest-register.min.css",
        "./css/deco-register": "./css/deco-register.css",
        "./css/deco-register/min": "./dist/css/deco-register.min.css",
        "./css/light-register": "./css/light-register.css",
        "./css/light-register/min": "./dist/css/light-register.min.css",
        "./css/grotesk-register": "./css/grotesk-register.css",
        "./css/grotesk-register/min": "./dist/css/grotesk-register.min.css",
        "./css/blueprint-register": "./css/blueprint-register.css",
        "./css/blueprint-register/min": "./dist/css/blueprint-register.min.css",
        "./css/nostromo-register": "./css/nostromo-register.css",
        "./css/nostromo-register/min": "./dist/css/nostromo-register.min.css",
        "./css/dark-register": "./css/dark-register.css",
        "./css/dark-register/min": "./dist/css/dark-register.min.css",
        "./css/formal-register": "./css/formal-register.css",
        "./css/formal-register/min": "./dist/css/formal-register.min.css",
        "./css/sepia-register": "./css/sepia-register.css",
        "./css/sepia-register/min": "./dist/css/sepia-register.min.css",
        "./css/solstice-register": "./css/solstice-register.css",
        "./css/solstice-register/min": "./dist/css/solstice-register.min.css",
        "./css/high-contrast-register": "./css/high-contrast-register.css",
        "./css/high-contrast-register/min": "./dist/css/high-contrast-register.min.css",
        "./css/lapis-register": "./css/lapis-register.css",
        "./css/lapis-register/min": "./dist/css/lapis-register.min.css",
        "./css/shade-dark-register": "./css/shade-dark-register.css",
        "./css/shade-dark-register/min": "./dist/css/shade-dark-register.min.css",
        "./css/layout": "./css/layout.css",
        "./css/layout/min": "./dist/css/layout.min.css",
        "./css/utilities": "./css/utilities.css",
        "./css/utilities/min": "./dist/css/utilities.min.css",
        "./dist/css": "./dist/kp-themes.css",
        "./dist/js": {
            "types": "./js/auto.d.ts",
            "default": "./dist/kp-themes.js"
        },
        "./css/fonts": "./css/fonts.css",
        "./css/fonts/min": "./dist/css/fonts.min.css",
        "./fonts/*": "./fonts/*",
        "./dist/css/min": "./dist/kp-themes.min.css",
        "./dist/js/min": {
            "types": "./js/auto.d.ts",
            "default": "./dist/kp-themes.min.js"
        },
        "./dist/css/*": "./dist/css/*"
    },
    "types": "./index.d.ts",
    "files": [
        "index.js",
        "index.d.ts",
        "hooks",
        "components",
        "fx",
        "js",
        "css",
        "fonts",
        "dist",
        "themes",
        "gates",
        "ha",
        "docs",
        "README.md",
        "MIGRATION.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "check:contrast": "node gates/check-contrast.mjs",
        "format": "prettier --write .",
        "gates": "npm run check:generated && npm run check:tokens && npm run check:layers && npm run check:relative-colour && npm run check:pressed-state && npm run check:variant-ground && npm run check:closure && npm run check:utilities && npm run check:bundle && npm run check:min && npm run check:migration && npm run check:wrappers && npm run check:docs-private && npm run check:docs-runnable && npm run check:doc-quotes && npm run check:strings && npm run check:compliance && npm run check:showcase && npm run check:site && npm run check:examples && npm run check:examples-wired && npm run check:baseline && npm run check:ids && npm run check:hooks && npm run check:register-coverage && npm run check:fonts && npm run check:fonts-css && npm run check:tear && npm run check:inline-styles && npm run check:ha && npm run check:package && npm run check:manifest && npm run check:types && npm run check:types:consumer && npm test && prettier --check .",
        "generate": "node gates/generate-themes.mjs",
        "generate:all": "npm run generate && npm run generate:fonts-css && npm run generate:utilities && npm run generate:tear && npm run generate:bundle && npm run generate:min && npm run generate:examples && npm run generate:showcase && npm run generate:site && npm run generate:ha && node gates/generate-compare.mjs && npm run report:di5 && npm run generate:types && node gates/compliance.mjs && npm run checksums && prettier --write . >/dev/null",
        "check:generated": "node gates/generate-themes.mjs --check",
        "check:tokens": "node gates/check-tokens.mjs",
        "test": "node --test gates/",
        "check:invariants": "node gates/check-invariants.mjs",
        "check:motion": "node gates/check-motion.mjs",
        "check:compliance": "node gates/compliance.mjs --check",
        "test:browser": "playwright test",
        "generate:bundle": "node gates/generate-bundle.mjs",
        "check:bundle": "node gates/generate-bundle.mjs --check",
        "check:migration": "node gates/check-migration.mjs",
        "check:wrappers": "node gates/check-wrappers.mjs",
        "generate:utilities": "node gates/generate-utilities.mjs",
        "check:utilities": "node gates/generate-utilities.mjs --check && node gates/check-utilities.mjs",
        "generate:showcase": "node gates/generate-showcase.mjs",
        "check:showcase": "node gates/generate-showcase.mjs --check",
        "generate:examples": "node gates/generate-examples.mjs",
        "check:examples": "node gates/generate-examples.mjs --check",
        "check:examples-wired": "node gates/check-examples-wired.mjs",
        "check:ids": "node gates/check-ids.mjs",
        "check:inline-styles": "node gates/check-inline-styles.mjs",
        "generate:site": "node gates/generate-site.mjs",
        "check:site": "node gates/generate-site.mjs --check && node gates/check-site.mjs",
        "checksums": "node gates/checksums.mjs --write",
        "consumer-tar": "node gates/consumer-tar.mjs",
        "check:types": "tsc --noEmit -p jsconfig.json",
        "check:layers": "node gates/check-layers.mjs",
        "check:relative-colour": "node gates/check-relative-colour.mjs",
        "check:pressed-state": "node gates/check-pressed-state.mjs",
        "check:variant-ground": "node gates/check-variant-ground.mjs",
        "check:closure": "node gates/check-closure.mjs",
        "check:strings": "node gates/check-strings.mjs",
        "generate:ha": "node gates/generate-ha-themes.mjs",
        "check:ha": "node gates/generate-ha-themes.mjs --check",
        "check:package": "node gates/check-package.mjs",
        "check:manifest": "node gates/check-manifest.mjs",
        "generate:types": "node gates/check-types.mjs --write",
        "check:types:consumer": "node gates/check-types.mjs",
        "check:hooks": "node gates/check-hooks.mjs",
        "check:register-coverage": "node gates/check-register-coverage.mjs",
        "check:fonts": "node gates/check-fonts.mjs",
        "generate:tear": "node gates/generate-tear.mjs",
        "check:tear": "node gates/generate-tear.mjs --check",
        "check:texture": "node gates/check-texture.mjs",
        "report:di5": "node gates/check-motion.mjs --report",
        "check:di5-report": "node gates/check-motion.mjs --report --check",
        "generate:fonts-css": "node gates/generate-fonts-css.mjs",
        "check:fonts-css": "node gates/generate-fonts-css.mjs --check",
        "check:baseline": "node gates/check-baseline.mjs",
        "generate:min": "node gates/generate-min.mjs",
        "check:min": "node gates/generate-min.mjs --check",
        "test:affected": "node gates/run-affected.mjs",
        "test:firefox": "playwright test --project=firefox",
        "advice": "npm run check:contrast ; npm run check:motion ; npm run check:di5-report ; npm run check:texture ; npm run check:invariants",
        "verify": "node gates/verify.mjs",
        "check:docs-private": "node gates/check-docs-private.mjs",
        "check:docs-runnable": "node gates/check-docs-runnable.mjs",
        "check:doc-quotes": "node gates/check-doc-quotes.mjs"
    },
    "peerDependencies": {
        "motion": ">=12",
        "react": ">=19"
    },
    "peerDependenciesMeta": {
        "motion": {
            "optional": true
        }
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "esbuild": "^0.28.2",
        "prettier": "^3.4.2",
        "react-dom": "^19.2.8",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=26 <27"
    }
}
