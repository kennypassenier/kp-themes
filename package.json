{
    "name": "@kp-soft/themes",
    "version": "5.1.0",
    "license": "MIT",
    "description": "The kp-soft house themes (seven data-theme palettes, registers, cyberpunk fx) as a shared package for React 19 apps.",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kennypassenier/kp-themes.git"
    },
    "sideEffects": [
        "*.css",
        "./js/auto.js"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.js"
        },
        "./fx": {
            "types": "./fx/index.d.ts",
            "default": "./fx/index.js"
        },
