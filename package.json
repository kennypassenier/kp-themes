{
    "name": "@kp-soft/themes",
    "version": "1.1.0",
    "license": "MIT",
    "description": "The kp-soft house themes (seven data-theme palettes, registers, cyberpunk fx) as a shared package for React 19 apps.",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kennypassenier/kp-themes.git"
    },
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": "./index.js",
        "./fx": "./fx/index.js",
        "./css": "./css/themes.css",
        "./css/tailwind-bridge": "./css/tailwind-bridge.css",
        "./css/register": "./css/cyberpunk-register.css",
        "./package.json": "./package.json",
        "./js/core": "./js/theme-core.js",
        "./js/picker": "./js/theme-picker.js",
        "./js/registry": "./js/theme-registry.js",
        "./js/no-flash": "./js/no-flash.js",
        "./css/components": "./css/components.css",
        "./js/components": "./js/components.js",
        "./js/overlays": "./js/overlays.js",
        "./js/listbox": "./js/listbox.js",
        "./js/combobox": "./js/combobox.js",
        "./js/palette": "./js/palette.js",
        "./js/datatable": "./js/datatable.js"
    },
    "types": "./index.d.ts",
    "files": [
        "index.js",
        "index.d.ts",
        "hooks",
        "components",
        "fx",
        "js",
        "css",
        "themes",
        "gates",
        "ha",
        "docs",
        "README.md",
        "MIGRATION.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "check:contrast": "node gates/check-contrast.mjs",
        "format": "prettier --write .",
        "gates": "npm run check:generated && npm run check:tokens && npm run check:invariants && npm run check:contrast && npm run check:motion && npm run check:layers && npm run check:compliance && npm run check:showcase && npm run check:ha && npm run check:package && npm run check:types && npm run check:types:consumer && npm test && prettier --check .",
        "generate": "node gates/generate-themes.mjs",
        "check:generated": "node gates/generate-themes.mjs --check",
        "check:tokens": "node gates/check-tokens.mjs",
        "test": "node --test gates/",
        "check:invariants": "node gates/check-invariants.mjs",
        "check:motion": "node gates/check-motion.mjs",
        "check:compliance": "node gates/compliance.mjs --check",
        "test:browser": "playwright test",
        "generate:showcase": "node gates/generate-showcase.mjs",
        "check:showcase": "node gates/generate-showcase.mjs --check",
        "checksums": "node gates/checksums.mjs --write",
        "check:types": "tsc --noEmit -p jsconfig.json",
        "check:layers": "node gates/check-layers.mjs",
        "generate:ha": "node gates/generate-ha-themes.mjs",
        "check:ha": "node gates/generate-ha-themes.mjs --check",
        "check:package": "node gates/check-package.mjs",
        "generate:types": "node gates/check-types.mjs --write",
        "check:types:consumer": "node gates/check-types.mjs"
    },
    "peerDependencies": {
        "motion": ">=12",
        "react": ">=19"
    },
    "peerDependenciesMeta": {
        "motion": {
            "optional": true
        }
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "esbuild": "^0.28.2",
        "prettier": "^3.4.2",
        "react-dom": "^19.2.8",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=26 <27"
    }
}
