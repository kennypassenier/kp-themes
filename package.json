{
    "name": "@kp-soft/themes",
    "version": "3.1.0",
    "license": "MIT",
    "description": "The kp-soft house themes (seven data-theme palettes, registers, cyberpunk fx) as a shared package for React 19 apps.",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kennypassenier/kp-themes.git"
    },
    "sideEffects": [
        "*.css",
        "./js/auto.js"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.js"
        },
        "./fx": {
            "types": "./fx/index.d.ts",
            "default": "./fx/index.js"
        },
        "./fx/*": "./fx/*",
        "./fx/boot-sequence": {
            "types": "./fx/boot-sequence.d.ts",
            "default": "./fx/boot-sequence.jsx"
        },
        "./fx/use-reduced-motion": {
            "types": "./fx/use-reduced-motion.d.ts",
            "default": "./fx/use-reduced-motion.js"
        },
        "./components/*": "./components/*",
        "./hooks/strings": {
            "types": "./hooks/use-strings.d.ts",
            "default": "./hooks/use-strings.jsx"
        },
        "./hooks/theme": {
            "types": "./hooks/use-theme.d.ts",
            "default": "./hooks/use-theme.js"
        },
        "./css": "./css/themes.css",
        "./css/rules": "./css/_rules.css",
        "./css/components": "./css/components.css",
        "./css/tailwind-bridge": "./css/tailwind-bridge.css",
        "./css/register": "./css/cyberpunk-register.css",
        "./themes/*": "./themes/*",
        "./package.json": "./package.json",
        "./js/auto": "./js/auto.js",
        "./js/core": {
            "types": "./js/theme-core.d.ts",
            "default": "./js/theme-core.js"
        },
        "./js/picker": {
            "types": "./js/theme-picker.d.ts",
            "default": "./js/theme-picker.js"
        },
        "./js/registry": {
            "types": "./js/theme-registry.d.ts",
            "default": "./js/theme-registry.js"
        },
        "./js/no-flash": {
            "types": "./js/no-flash.d.ts",
            "default": "./js/no-flash.js"
        },
        "./js/components": {
            "types": "./js/components.d.ts",
            "default": "./js/components.js"
        },
        "./js/overlays": {
            "types": "./js/overlays.d.ts",
            "default": "./js/overlays.js"
        },
        "./js/listbox": {
            "types": "./js/listbox.d.ts",
            "default": "./js/listbox.js"
        },
        "./js/combobox": {
            "types": "./js/combobox.d.ts",
            "default": "./js/combobox.js"
        },
        "./js/palette": {
            "types": "./js/palette.d.ts",
            "default": "./js/palette.js"
        },
        "./js/datatable": {
            "types": "./js/datatable.d.ts",
            "default": "./js/datatable.js"
        },
        "./js/forms": {
            "types": "./js/forms.d.ts",
            "default": "./js/forms.js"
        },
        "./js/patterns": {
            "types": "./js/patterns.d.ts",
            "default": "./js/patterns.js"
        },
        "./js/structure": {
            "types": "./js/structure.d.ts",
            "default": "./js/structure.js"
        },
        "./js/datepicker": {
            "types": "./js/datepicker.d.ts",
            "default": "./js/datepicker.js"
        },
        "./js/upload": {
            "types": "./js/upload.d.ts",
            "default": "./js/upload.js"
        },
        "./js/wizard": {
            "types": "./js/wizard.d.ts",
            "default": "./js/wizard.js"
        },
        "./js/contrast": {
            "types": "./js/contrast.d.ts",
            "default": "./js/contrast.js"
        },
        "./js/colorpicker": {
            "types": "./js/colorpicker.d.ts",
            "default": "./js/colorpicker.js"
        },
        "./js/gridlayout": {
            "types": "./js/gridlayout.d.ts",
            "default": "./js/gridlayout.js"
        },
        "./js/strings": {
            "types": "./js/strings.d.ts",
            "default": "./js/strings.js"
        },
        "./hooks/controllable": {
            "types": "./hooks/use-controllable.d.ts",
            "default": "./hooks/use-controllable.js"
        },
        "./css/retro-register": "./css/retro-register.css"
    },
    "types": "./index.d.ts",
    "files": [
        "index.js",
        "index.d.ts",
        "hooks",
        "components",
        "fx",
        "js",
        "css",
        "themes",
        "gates",
        "ha",
        "docs",
        "README.md",
        "MIGRATION.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "check:contrast": "node gates/check-contrast.mjs",
        "format": "prettier --write .",
        "gates": "npm run check:generated && npm run check:tokens && npm run check:invariants && npm run check:contrast && npm run check:motion && npm run check:layers && npm run check:strings && npm run check:compliance && npm run check:showcase && npm run check:ha && npm run check:package && npm run check:types && npm run check:types:consumer && npm test && prettier --check .",
        "generate": "node gates/generate-themes.mjs",
        "check:generated": "node gates/generate-themes.mjs --check",
        "check:tokens": "node gates/check-tokens.mjs",
        "test": "node --test gates/",
        "check:invariants": "node gates/check-invariants.mjs",
        "check:motion": "node gates/check-motion.mjs",
        "check:compliance": "node gates/compliance.mjs --check",
        "test:browser": "playwright test",
        "generate:showcase": "node gates/generate-showcase.mjs",
        "check:showcase": "node gates/generate-showcase.mjs --check",
        "checksums": "node gates/checksums.mjs --write",
        "check:types": "tsc --noEmit -p jsconfig.json",
        "check:layers": "node gates/check-layers.mjs",
        "check:strings": "node gates/check-strings.mjs",
        "generate:ha": "node gates/generate-ha-themes.mjs",
        "check:ha": "node gates/generate-ha-themes.mjs --check",
        "check:package": "node gates/check-package.mjs",
        "generate:types": "node gates/check-types.mjs --write",
        "check:types:consumer": "node gates/check-types.mjs"
    },
    "peerDependencies": {
        "motion": ">=12",
        "react": ">=19"
    },
    "peerDependenciesMeta": {
        "motion": {
            "optional": true
        }
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "esbuild": "^0.28.2",
        "prettier": "^3.4.2",
        "react-dom": "^19.2.8",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=26 <27"
    }
}
