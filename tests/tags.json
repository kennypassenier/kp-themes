        { "path": "components/patterns.jsx", "tags": ["@component:data"] },
        { "path": "components/sidenav.jsx", "tags": ["@component:navigation"] },
        { "path": "components/structure.jsx", "tags": ["@component:structure", "@component:media"] },
        { "path": "components/switch.jsx", "tags": ["@component:switch"] },
        { "path": "components/table.jsx", "tags": ["@component:table"] },
        { "path": "components/theme-switcher.jsx", "tags": ["@component:picker"] },
        { "path": "hooks/use-theme.js", "tags": ["@component:picker"] },
        { "path": "hooks/**", "all": "shared by every React component" },
        { "path": "fx/**", "tags": ["@component:page-effects"] },

        { "path": "catalogue/index.html", "tags": ["@component:catalogue"] },
        { "path": "catalogue/compare.html", "tags": ["@component:catalogue"] },
        { "path": "catalogue/{component}.html", "tags": ["@component:catalogue", "@component:{component}"] },
