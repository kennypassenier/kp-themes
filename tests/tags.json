        { "path": "js/effects.js", "tags": ["@component:page-effects", "@component:media"] },
        { "path": "js/theme-picker.js", "tags": ["@component:picker"] },
        { "path": "js/theme-core.js", "tags": ["@component:picker"] },
        { "path": "js/no-flash.js", "tags": ["@component:picker"] },
        { "path": "js/lazy-register.js", "tags": ["@component:picker"] },
        { "path": "js/diagnostics.js", "tags": ["@component:picker"] },
        { "path": "js/theme-registry.js", "tags": ["@sweep", "@component:picker"], "why": "generated from every theme's tokens" },
        { "path": "js/strings.js", "all": "the dictionary every component and many specs read" },
        { "path": "js/auto.js", "all": "attaches every module on every fixture page" },
        { "path": "index.js", "tags": ["@component:bundle", "@sweep"] },

        { "path": "components/alert.jsx", "tags": ["@component:feedback"] },
