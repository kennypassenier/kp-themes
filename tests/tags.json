        { "path": "js/forms.js", "tags": ["@component:field", "@component:switch", "@component:structure"] },
        { "path": "js/wizard.js", "tags": ["@component:structure"] },
        { "path": "js/upload.js", "tags": ["@component:upload"] },
        { "path": "js/structure.js", "tags": ["@component:structure"] },
        { "path": "js/patterns.js", "tags": ["@component:data"] },
        { "path": "js/gridlayout.js", "tags": ["@component:media"] },
        { "path": "js/colorpicker.js", "tags": ["@component:colorpicker"] },
