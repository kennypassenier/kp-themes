        { "path": "js/sidenav.js", "tags": ["@component:navigation"] },
        { "path": "js/overlays.js", "tags": ["@component:overlays", "@component:feedback", "@component:navigation", "@component:data"] },
        {
            "path": "js/components.js",
            "tags": ["@component:button", "@component:overlays", "@component:feedback", "@component:navigation", "@component:page"]
