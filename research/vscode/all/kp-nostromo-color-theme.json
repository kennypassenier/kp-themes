) {\n    <span class=\"kp-code__keyword\">for</span> (<span class=\"kp-code__keyword\">const</span> name <span class=\"kp-code__keyword\">of</span> names) {\n        <span class=\"kp-code__keyword\">const</span> ratio = <span class=\"kp-code__keyword\">await</span> measure(name, <span class=\"kp-code__string\">'foreground'</span>);\n        <span class=\"kp-code__keyword\">if</span> (ratio &gt;= floor) <span class=\"kp-code__keyword\">return</span> { name, ratio };\n    }\n    <span class=\"kp-code__keyword\">return</span> <span class=\"kp-code__keyword\">null</span>;\n}"},"contrast":[{"what":"editor.foreground on editor.background","ratio":9.43,"floor":4.5},{"what":"comment (muted-foreground) on editor.background","ratio":5.2,"floor":4.5},{"what":"keyword (chart-1) on editor.background","ratio":3.77,"floor":4.5},{"what":"string (chart-2) on editor.background","ratio":9.43,"floor":4.5},{"what":"type (foreground) on editor.background","ratio":9.43,"floor":4.5},{"what":"function (foreground) on editor.background","ratio":9.43,"floor":4.5},{"what":"editor.foreground on selection","ratio":5.48,"floor":4.5},{"what":"comment on selection","ratio":3.02,"floor":4.5},{"what":"selection against editor.background (non-text)","ratio":1.72,"floor":3},{"what":"editor.foreground on line highlight","ratio":8.21,"floor":4.5},{"what":"comment on line highlight","ratio":4.52,"floor":4.5},{"what":"line highlight against editor.background (non-text)","ratio":1.15,"floor":3},{"what":"editorLineNumber.foreground on editor","ratio":5.2,"floor":4.5},{"what":"statusBar.foreground on statusBar.background","ratio":9.43,"floor":4.5},{"what":"sideBar.foreground on sideBar.background","ratio":11.84,"floor":4.5},{"what":"list selection ink on its sidebar-primary/0.14 wash","ratio":9.62,"floor":4.5},{"what":"tab.inactiveForeground on tab.inactiveBackground","ratio":5.84,"floor":4.5},{"what":"button.foreground on button.background","ratio":11.54,"floor":4.5},{"what":"badge.foreground on badge.backgr