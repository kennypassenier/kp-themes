# Verbatim copies from kp-soft - not reformatted here.
docs/

# Hook copies synced from ~/Projects/dev-procedure by hooks/sync-hooks.sh.
# They are byte-compared against the canonical file, so a formatter
# rewriting them puts this repository permanently "BEHIND" in that tool
# and re-fights the same diff after every sync (found 2026-09-16, when
# prettier reformatted the freshly synced trace-inputs.cjs).
.githooks/
node_modules/
package-lock.json

# Generated artefacts. Their shape is the generator's business, and a
# formatter rewriting them would put `npm run gates` permanently at odds
# with itself: the check compares the file to what the generator writes.
ha/
showcase/index.html
showcase/diagnostics.html
showcase/themes/

# The dist bundle, written by gates/generate-bundle.mjs. esbuild's
# output has its own shape; reformatting it would put the file and its
# source permanently at odds.
dist/

# The documentation site, written by gates/generate-site.mjs. Its shape
# is the generator's; reformatting it would put the file and its source
# permanently at odds.
site/
examples/
tests/fixtures/.build/

# Generated by gates/check-types.mjs from the JSDoc sources. Formatting
# them would put them permanently at odds with the generator, and the
# types gate compares them byte for byte.
*.d.ts

# Parallel worktrees (standing rule 19) live here; each is a full checkout
# and formatting them from the main one would rewrite another branch.
.claude/worktrees/

# Throwaway measurement specs. This project writes them constantly --
# "does this actually overflow", "what does the register paint" -- and
# they exist for one command before being deleted. A formatter complaining
# about a probe is noise, and a probe that reaches a commit is a mistake
# the ignore below catches rather than hides.
tests/tmp-*.spec.mjs
# Generated ledgers: written by a gate, refused by the same gate when stale.
reports/
# Generated from fonts/families.json and held by its own gate; its unicode-range lines are one value each on purpose.
css/fonts.css
# The 4.0.0 bundle vendored for the compare page, verified against its own SHA256SUMS [MR-R6-COMPARE].
showcase/baseline/

# Generated by research/loading/run.mjs, and gitignored with it.
research/loading/out/

# Generated by gates/generate-portraits.mjs from themes/*/signature.json; gates/portraits.test.mjs compares them byte for byte [scope-97].
research/theme-portraits/*.html

# Generated research output, byte-exact: the Jellyfin paste carries a sha256
# Kenny can compare after pasting, and the VS Code theme JSON must match what
# the .vsix packs.
research/jellyfin-dark/*.css
research/vscode/all/
research/vscode/extension/

# Generated by gates/generate-windows.mjs; check:windows compares them byte
# for byte. The Windows-side files beside them are read by programs with their
# own parsers (regedit, Firefox's user.js, PowerShell), so they keep their shape.
windows/*/
windows/firedragon-user.js
